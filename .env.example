# Copy to .env and fill in what you use. Everything is optional —
# without SMTP/ntfy the app still works via in-app push notifications.

# How often (minutes) to re-check all tracked prices
CHECK_INTERVAL_MINUTES=60

# Seconds to wait between two scrapes in one run (be polite to the shops)
SCRAPE_DELAY_SECONDS=5

# --- Email notifications (leave empty to disable) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
# For Gmail use an App Password: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=
SMTP_FROM=you@gmail.com
ALERT_EMAIL_TO=you@gmail.com

# --- Instant push via ntfy (leave empty to disable) ---
# Pick a long random topic name, then subscribe to it in the ntfy app
# (https://ntfy.sh) on your phone for instant pushes.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
